{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "rootDir": ".."
  },
  "include": [
    ".",
    "../frontend/apolloAssistMachine.ts",
    "../frontend/src/inputMapping.ts",
    "../frontend/src/stateResponses.ts",
    "../frontend/src/knowledgeBase.ts",
    "../data/**/*.json"
  ],
  "exclude": [
    "prisma.config.ts"
  ]
}
